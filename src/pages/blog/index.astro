---
import BlogLayout from '../../layouts/BlogLayout.astro';
import ListFilter from '../../components/ListFilter.astro';
import EntryMeta from '../../components/EntryMeta.astro';
import { getPublishedPosts, getWritingEntries, getPartTitle } from '../../utils/blog.js';
import { formatMonthDay } from '../../utils/dates.js';

const entries = getWritingEntries(await getPublishedPosts());

// Filter options: every tag in use, most common first (a series counts once)
const tagCounts = new Map();
for (const entry of entries) {
  for (const tag of entry.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}
const tags = Array.from(tagCounts.keys()).sort((a, b) => tagCounts.get(b) - tagCounts.get(a));

// Group by year, newest first; entries are already sorted
const years = [];
for (const entry of entries) {
  const year = entry.date.getUTCFullYear();
  const group = years.find((g) => g.year === year);
  if (group) group.entries.push(entry); else years.push({ year, entries: [entry] });
}


// A series spans the months from its first part to its last
function entryDate(entry) {
  if (entry.parts === 0) return formatMonthDay(entry.date);
  const first = formatMonthDay(entry.seriesPosts[0].data.date);
  const last = formatMonthDay(entry.seriesPosts.at(-1).data.date);
  return first === last ? first : `${first} – ${last}`;
}

// Everything the search box matches against; a series also matches on its parts' titles
const searchText = (entry) => [entry.title, entry.abstract, ...entry.tags, ...entry.seriesPosts.map((part) => part.data.title)].join(' ').toLowerCase();

const muted = 'text-[var(--color-light-text-secondary)] dark:text-[var(--color-dark-text-secondary)]';
const soft = 'text-[var(--color-light-text-soft)] dark:text-[var(--color-dark-text-soft)]';
const accent = 'text-[var(--color-light-accent)] dark:text-[var(--color-dark-accent)]';
const groupHoverAccent = 'group-hover:text-[var(--color-light-accent)] dark:group-hover:text-[var(--color-dark-accent)] transition-colors';
const borderColor = 'border-[var(--color-light-border)] dark:border-[var(--color-dark-border)]';
---

<BlogLayout title="Writing" description="Notes on graphics, C++, and the problems I run into while building things.">

  <!-- Intro + filters -->
  <section class="flex flex-col gap-3.5">
    <div class="flex flex-wrap justify-between items-baseline gap-x-4 gap-y-2">
      <h1 class="text-[clamp(28px,3.6vw,36px)] leading-[1.2] font-semibold tracking-[-0.015em]">Writing</h1>
      <a href="/rss.xml" class={`inline-flex items-center gap-1.5 text-sm no-underline ${accent} hover:text-[var(--color-light-text)] dark:hover:text-[var(--color-dark-text)] transition-colors`}>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 11a8 8 0 0 1 8 8" /><path d="M5 5a14 14 0 0 1 14 14" /><circle cx="6" cy="18" r="1" /></svg>
        RSS
      </a>
    </div>
    <p class={`max-w-[680px] text-lg leading-[1.7] ${soft}`}>
      Notes on graphics, C++, and the problems I run into while building things.
    </p>
    {entries.length > 0 && (
      <ListFilter
        tags={tags.map((tag) => ({ tag, count: tagCounts.get(tag) }))}
        placeholder="Search writing…"
        label="Search writing"
        filterLabel="Filter by topic"
      />
    )}
  </section>

  {entries.length === 0 && (
    <p class={`min-h-[30vh] flex items-center justify-center italic text-lg ${muted}`}>
      Posts coming soon.
    </p>
  )}

  <!-- Posts grouped by year -->
  {entries.length > 0 && (
    <section class="flex flex-col gap-11" aria-label="Posts">
      {years.map(({ year, entries }) => (
        <div class="filter-group flex flex-col gap-3">
          <h2 class={`font-mono text-[13px] font-medium leading-none ${muted}`}>{year}</h2>
          <ul class="flex flex-col">
            {entries.map((entry) => (
              <li class={`filter-item border-t ${borderColor} py-6`} data-tags={entry.tags.join('|')} data-search={searchText(entry)}>
                <div class="min-w-0 flex flex-col gap-1.5">
                <!-- Month and day above the title; the year is the group heading -->
                <span class={`font-mono text-xs ${muted}`}>{entryDate(entry)}</span>
                <div class="flex flex-wrap justify-between items-center gap-x-5 gap-y-1">
                  <a href={entry.href} class="flex-[1_1_360px] text-lg font-semibold leading-[1.45] no-underline hover:text-[var(--color-light-accent)] dark:hover:text-[var(--color-dark-accent)] transition-colors">
                    {entry.title}
                  </a>
                  <EntryMeta tags={entry.tags} />
                </div>
                <p class={`text-[15px] leading-[1.6] ${soft}`}>{entry.abstract}</p>

                <!-- A series lists its parts on demand -->
                {entry.parts > 0 && (
                  <details class="group/parts">
                    <summary class={`inline-flex items-center gap-1.5 min-h-8 text-sm cursor-pointer list-none [&::-webkit-details-marker]:hidden ${soft} hover:text-[var(--color-light-text)] dark:hover:text-[var(--color-dark-text)]`}>
                      <svg class="w-3 h-3 transition-transform group-open/parts:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                      <span class="group-open/parts:hidden">Show all {entry.parts} parts</span>
                      <span class="hidden group-open/parts:inline">Hide parts</span>
                    </summary>
                    <ol class={`mt-2 max-w-[760px] pl-[18px] border-l ${borderColor} flex flex-col gap-0.5`}>
                      {entry.seriesPosts.map((part) => (
                        <li>
                          <a href={`/blog/${part.id}`} class="group flex justify-between items-baseline gap-4 py-[7px] text-[15px] no-underline">
                            <span class={groupHoverAccent}>
                              <span class={`inline-block min-w-[28px] font-mono text-xs ${muted}`}>{String(part.data.series.part).padStart(2, '0')}</span>
                              {getPartTitle(part)}
                            </span>
                            <time datetime={part.data.date.toISOString()} class={`font-mono text-xs whitespace-nowrap ${muted}`}>{formatMonthDay(part.data.date)}</time>
                          </a>
                          </div>
              </li>
                      ))}
                    </ol>
                  </details>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class={`filter-empty py-12 text-center italic text-[15px] ${muted}`} hidden>No posts found.</p>
    </section>
  )}

</BlogLayout>
