---
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPublishedPosts, getSeriesPosts } from '../../utils/blog.js';
import { getPublishedProjects, getProjectsForPost } from '../../utils/projects.js';

export async function getStaticPaths() {
  // Newest first, so the next index is the older post
  const posts = await getPublishedPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const seriesPosts = post.data.series ? getSeriesPosts(await getPublishedPosts(), post.data.series.name) : [];
const projects = getProjectsForPost(await getPublishedProjects(), post);
---

<BlogPostLayout
  post={post}
  headings={headings}
  seriesPosts={seriesPosts}
  projects={projects}
  newer={newer}
  older={older}
>
  <Content />
</BlogPostLayout>
