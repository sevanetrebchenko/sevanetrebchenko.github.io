---
import { render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import { getPublishedProjects, hasPage } from '../../utils/projects.js';
import { getPublishedPosts } from '../../utils/blog.js';

export async function getStaticPaths() {
  // Showcase projects always get a page; small ones only with a write-up (see hasPage)
  const pages = (await getPublishedProjects()).filter(hasPage);
  return pages.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: pages[i - 1], next: pages[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { Content, headings } = await render(project);

const posts = await getPublishedPosts();
const related = project.data.writing
  .map((id) => posts.find((post) => post.id === id))
  .filter(Boolean);
---

<ProjectLayout
  project={project}
  headings={headings}
  related={related}
  prev={prev}
  next={next}
>
  <Content />
</ProjectLayout>
