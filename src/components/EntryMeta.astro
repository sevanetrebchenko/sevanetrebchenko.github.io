---
// A list entry's tags, on the right of its title line. They stay on one line: when they don't fit,
// they scroll sideways, with an arrow and a fade on whichever side has more.
// ListFilter marks tags matching a selected filter as active (accent).
const { tags = [] } = Astro.props;

const arrow = 'entry-tags-arrow hidden shrink-0 items-center justify-center w-6 h-6 rounded text-[var(--color-light-text-secondary)] dark:text-[var(--color-dark-text-secondary)] hover:text-[var(--color-light-text)] dark:hover:text-[var(--color-dark-text)] transition-colors';
---

{tags.length > 0 && (
  <div class="entry-tags flex items-center min-w-0 max-w-full sm:max-w-[45%]">
    <button type="button" class={`${arrow} entry-tags-prev`} aria-label="Scroll tags left" tabindex="-1">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <div class="entry-tags-scroll min-w-0 overflow-x-auto whitespace-nowrap font-mono text-[13px] text-[var(--color-light-text-secondary)] dark:text-[var(--color-dark-text-secondary)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {tags.map((tag, i) => (
        <>{i > 0 && <span class="mx-2 opacity-50" aria-hidden="true">|</span>}<span class="entry-tag transition-colors data-active:text-[var(--color-light-accent)] dark:data-active:text-[var(--color-dark-accent)]" data-tag={tag}>{tag}</span></>
      ))}
    </div>
    <button type="button" class={`${arrow} entry-tags-next`} aria-label="Scroll tags right" tabindex="-1">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
    </button>
  </div>
)}

<style>
  /* Fade the edge(s) the tags continue past */
  .entry-tags[data-more="right"] .entry-tags-scroll {
    mask-image: linear-gradient(to right, black calc(100% - 20px), transparent);
  }
  .entry-tags[data-more="left"] .entry-tags-scroll {
    mask-image: linear-gradient(to left, black calc(100% - 20px), transparent);
  }
  .entry-tags[data-more="both"] .entry-tags-scroll {
    mask-image: linear-gradient(to right, transparent, black 20px, black calc(100% - 20px), transparent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.entry-tags').forEach((root) => {
    const scroll = root.querySelector<HTMLElement>('.entry-tags-scroll')!;
    const prev = root.querySelector<HTMLElement>('.entry-tags-prev')!;
    const next = root.querySelector<HTMLElement>('.entry-tags-next')!;

    function update() {
      const left = scroll.scrollLeft > 0;
      const right = scroll.scrollLeft + scroll.clientWidth < scroll.scrollWidth - 1;
      prev.classList.toggle('hidden', !left);
      prev.classList.toggle('inline-flex', left);
      next.classList.toggle('hidden', !right);
      next.classList.toggle('inline-flex', right);
      if (left && right) root.dataset.more = 'both';
      else if (left || right) root.dataset.more = left ? 'left' : 'right';
      else delete root.dataset.more;
    }

    const step = () => Math.max(60, scroll.clientWidth * 0.7);
    prev.addEventListener('click', () => scroll.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => scroll.scrollBy({ left: step(), behavior: 'smooth' }));
    scroll.addEventListener('scroll', update, { passive: true });
    // Also covers entries becoming visible again after the list is filtered
    new ResizeObserver(update).observe(scroll);
    update();
  });
</script>
