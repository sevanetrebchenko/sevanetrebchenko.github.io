---
import { posterFor } from '../utils/media.js';
const { project } = Astro.props;
const { title, description } = project.data;
// A clip's poster stands in for it here
const thumbnail = posterFor(project.data.thumbnail);
const href = `/projects/${project.id}`;
---

<a href={href} class="group flex flex-col gap-3 no-underline">
  {thumbnail ? (
    <img
      src={thumbnail}
      alt={title}
      loading="lazy"
      class="aspect-[16/10] w-full object-cover rounded-lg border border-[var(--color-light-border)] dark:border-[var(--color-dark-border)]"
    />
  ) : (
    <div
      class="thumb-placeholder aspect-[16/10] rounded-lg border border-[var(--color-light-border)] dark:border-[var(--color-dark-border)]"
      role="img"
      aria-label={`${title} (no capture yet)`}
    ></div>
  )}

  <div class="flex justify-between items-baseline gap-3">
    <h3 class="text-[19px] font-semibold leading-[1.35] text-[var(--color-light-text)] dark:text-[var(--color-dark-text)] group-hover:text-[var(--color-light-accent)] dark:group-hover:text-[var(--color-dark-accent)] transition-colors">
      {title}
    </h3>
    <span class="font-mono text-xs whitespace-nowrap text-[var(--color-light-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
      {project.data.date.getUTCFullYear()}
    </span>
  </div>

  <p class="text-[15px] leading-[1.6] text-[var(--color-light-text-soft)] dark:text-[var(--color-dark-text-soft)]">
    {description}
  </p>
</a>
