---
const { headings } = Astro.props;
if (!headings || headings.length === 0) return;

const tocItems = headings.filter(h => h.depth === 2 || h.depth === 3);
if (tocItems.length === 0) return;

---

<nav
  class="sticky max-h-[calc(100vh-5rem)] overflow-y-auto flex flex-col gap-2.5 text-sm"
  style="top: 2.5rem;"
  aria-label="Contents"
>
  <span class="text-xs font-semibold uppercase tracking-[0.06em] text-[var(--color-light-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
    Contents
  </span>
  <ol class="flex flex-col list-none p-0 m-0 border-l border-[var(--color-light-border)] dark:border-[var(--color-dark-border)]">
    {tocItems.map((heading) => (
      <li>
        <a
          href={`#${heading.slug}`}
          class:list={['toc-link', heading.depth === 3 && 'toc-link-sub']}
          data-heading={heading.slug}
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script is:inline>
// Sync inline HTML from rendered headings into TOC links before first paint
document.querySelectorAll('.toc-link').forEach(function(link) {
  var heading = document.getElementById(link.getAttribute('data-heading'));
  if (heading && heading.querySelector('code')) {
    link.innerHTML = heading.innerHTML;
  }
});
</script>

<script>
  const links = document.querySelectorAll('.toc-link');
  if (links.length > 0) {
    const headingEls = Array.from(links).map(link => {
      return document.getElementById(link.getAttribute('data-heading'));
    }).filter(Boolean);

    const setActive = (id) => {
      links.forEach(link => { link.classList.remove('active'); link.removeAttribute('aria-current'); });
      const active = document.querySelector(`.toc-link[data-heading="${id}"]`);
      if (active) { active.classList.add('active'); active.setAttribute('aria-current', 'true'); }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    );

    headingEls.forEach(el => observer.observe(el));
  }
</script>
