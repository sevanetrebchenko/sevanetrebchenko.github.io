---
import BaseLayout from './BaseLayout.astro';
import ArticleBody from '../components/ArticleBody.astro';
import { getPartTitle, getReadingMinutes } from '../utils/blog.js';
import { formatDate } from '../utils/dates.js';
import { getLastModified } from '../utils/last-modified.js';

const { post, headings, seriesPosts = [], projects = [], newer, older } = Astro.props;
const { title, abstract, date, series } = post.data;
const lastModified = getLastModified(post);

// Only show "Updated" if lastModified is more than 7 days after publish
const updated = lastModified && lastModified.valueOf() - date.valueOf() >= 7 * 24 * 60 * 60 * 1000 ? formatDate(lastModified) : null;
const readingMinutes = getReadingMinutes(post.body);
const hasSeries = seriesPosts.length >= 2;

// Previous/next: a series part steps through its series by part number; other posts step through the blog by date
const partIndex = seriesPosts.findIndex((part) => part.id === post.id);
const prevPost = hasSeries ? seriesPosts[partIndex - 1] : older;
const nextPost = hasSeries ? seriesPosts[partIndex + 1] : newer;
const nav = hasSeries
  ? { prev: 'Previous part', next: 'Next part', first: 'This is the first part.', last: 'This is the last part.' }
  : { prev: 'Older', next: 'Newer', first: 'This is the first post.', last: 'This is the latest post.' };
const navTitle = (p) => hasSeries ? `Part ${p.data.series.part} — ${getPartTitle(p)}` : p.data.title;

const muted = 'text-[var(--color-light-text-secondary)] dark:text-[var(--color-dark-text-secondary)]';
const soft = 'text-[var(--color-light-text-soft)] dark:text-[var(--color-dark-text-soft)]';
const accent = 'text-[var(--color-light-accent)] dark:text-[var(--color-dark-accent)]';
const groupHoverAccent = 'group-hover:text-[var(--color-light-accent)] dark:group-hover:text-[var(--color-dark-accent)] transition-colors';
const borderColor = 'border-[var(--color-light-border)] dark:border-[var(--color-dark-border)]';
---

<BaseLayout title={title} description={abstract} ogType="article">
  <!-- JSON-LD structured data for blog post -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description: abstract,
      datePublished: date.toISOString(),
      dateModified: (lastModified || date).toISOString(),
      author: {
        "@type": "Person",
        name: "Seva Netrebchenko",
      },
    })}
  />

  <main class="relative max-w-[1040px] mx-auto px-5 pt-8 pb-24 flex flex-col gap-11">

    <!-- Title block -->
    <header class="flex flex-col gap-3.5">
      <a href="/blog" class={`self-start inline-flex items-center gap-1.5 min-h-11 text-sm no-underline ${muted} hover:text-[var(--color-light-accent)] dark:hover:text-[var(--color-dark-accent)] transition-colors`}><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>Back to writing</a>
      {hasSeries ? (
        <!-- A series part leads with the series; the part is a subtitle under it -->
        <hgroup class="flex flex-col gap-2">
          <h1 class="max-w-[820px] text-[clamp(30px,4vw,42px)] leading-[1.18] font-semibold tracking-[-0.02em]">{series.name}</h1>
          <p class={`max-w-[820px] text-[clamp(22px,2.6vw,26px)] leading-[1.3] ${soft}`}>
            <a href="#series" class="no-underline hover:text-[var(--color-light-accent)] dark:hover:text-[var(--color-dark-accent)] transition-colors">Part {series.part}</a> — {getPartTitle(post)}
          </p>
        </hgroup>
      ) : (
        <h1 class="max-w-[820px] text-[clamp(30px,4vw,42px)] leading-[1.18] font-semibold tracking-[-0.02em]">{title}</h1>
      )}
      <p class={`max-w-[760px] text-[19px] leading-[1.65] ${soft}`}>{abstract}</p>
      <div class={`mt-1 flex flex-wrap items-baseline gap-x-2.5 gap-y-1.5 font-mono text-xs ${muted}`}>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <><span aria-hidden="true">·</span><span>updated {updated}</span></>}
        <span aria-hidden="true">·</span>
        <span>{readingMinutes} min read</span>
      </div>
    </header>

    <!-- Body -->
    <div class={`pt-10 border-t ${borderColor}`}>
      <ArticleBody headings={headings}>
        <slot />
      </ArticleBody>
    </div>

    <!-- End of post: previous/next, then the series' parts, then the related project -->
    <div class={`-mt-3 pt-6 border-t ${borderColor} flex flex-col gap-10`}>

      <nav class="flex flex-wrap justify-between gap-4 text-base leading-normal" aria-label={hasSeries ? 'Series parts' : 'More posts'}>
        {prevPost ? (
          <a href={`/blog/${prevPost.id}`} class="group flex-[1_1_240px] flex flex-col gap-1 no-underline">
            <span class={`inline-flex items-center gap-1 self-start text-[13px] ${muted}`}><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>{nav.prev}</span>
            <span class={`font-semibold leading-snug ${groupHoverAccent}`}>{navTitle(prevPost)}</span>
          </a>
        ) : (
          <span class={`flex-[1_1_240px] flex flex-col gap-1 ${muted}`}>
            <span class="inline-flex items-center gap-1 self-start text-[13px]"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>{nav.prev}</span>
            <span class="italic">{nav.first}</span>
          </span>
        )}
        {nextPost ? (
          <a href={`/blog/${nextPost.id}`} class="group flex-[1_1_240px] flex flex-col gap-1 text-right no-underline">
            <span class={`inline-flex items-center gap-1 self-end text-[13px] ${muted}`}>{nav.next}<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></span>
            <span class={`font-semibold leading-snug ${groupHoverAccent}`}>{navTitle(nextPost)}</span>
          </a>
        ) : (
          <span class={`flex-[1_1_240px] flex flex-col gap-1 text-right ${muted}`}>
            <span class="inline-flex items-center gap-1 self-end text-[13px]">{nav.next}<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></span>
            <span class="italic">{nav.last}</span>
          </span>
        )}
      </nav>

      {hasSeries && (
        <section id="series" class="flex flex-col gap-3 scroll-mt-8" aria-labelledby="series-heading">
          <div class="flex justify-between items-baseline gap-3">
            <h2 id="series-heading" class="text-xl font-semibold leading-[1.3]">{series.name}</h2>
            <span class={`font-mono text-xs ${muted}`}>{seriesPosts.length} parts</span>
          </div>
          <ol class={`border-t ${borderColor}`}>
            {seriesPosts.map((part) => {
              const current = part.id === post.id;
              return (
                <li class={`border-b ${borderColor}`}>
                  <a
                    href={`/blog/${part.id}`}
                    class="group flex justify-between items-baseline gap-4 py-2.5 text-[15px] no-underline"
                    aria-current={current ? 'page' : undefined}
                  >
                    <span class:list={[current ? `font-semibold ${accent}` : groupHoverAccent]}>
                      <span class={`inline-block min-w-[30px] font-mono text-xs ${muted}`}>{String(part.data.series.part).padStart(2, '0')}</span>
                      {getPartTitle(part)}
                    </span>
                    <time datetime={part.data.date.toISOString()} class={`font-mono text-xs whitespace-nowrap ${muted}`}>{formatDate(part.data.date)}</time>
                  </a>
                </li>
              );
            })}
          </ol>
        </section>
      )}

      {projects.map((project) => (
        <a href={`/projects/${project.id}`} class={`group flex flex-col gap-1.5 px-5 py-[18px] rounded-[10px] border ${borderColor} no-underline hover:border-[var(--color-light-accent)] dark:hover:border-[var(--color-dark-accent)] transition-colors`}>
          <span class={`font-mono text-xs ${muted}`}>Related project</span>
          <span class={`inline-flex items-center gap-1.5 text-lg font-semibold leading-[1.4] ${groupHoverAccent}`}>{project.data.title}<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg></span>
          <span class={`text-[15px] leading-[1.6] ${soft}`}>{project.data.description}</span>
        </a>
      ))}
    </div>

  </main>
</BaseLayout>

<script src="../utils/code-blocks.js"></script>
<script src="../utils/media-player.js"></script>
