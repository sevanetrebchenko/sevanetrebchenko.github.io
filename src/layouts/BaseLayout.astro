---
import Head from '../components/Head.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

const { title, description, ogType } = Astro.props;
const fullTitle = title && title !== 'Seva Netrebchenko' ? `${title} — Seva Netrebchenko` : 'Seva Netrebchenko';
const year = new Date().getFullYear();

const footerLinks = [
  { href: 'https://github.com/sevanetrebchenko', label: 'GitHub', external: true },
  { href: 'https://www.linkedin.com/in/seva-netrebchenko/', label: 'LinkedIn', external: true },
  { href: '/rss.xml', label: 'RSS', external: false },
];
---

<html lang="en" class="no-transitions">
  <head>
    <!-- Theme: must run before any CSS to prevent flash -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <Head title={fullTitle} description={description} ogType={ogType} />
    <script is:inline>
      requestAnimationFrame(function() {
        document.documentElement.classList.remove('no-transitions');
      });
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <SiteHeader />
    <div class="flex-1">
      <slot />
    </div>
    <footer class="max-w-[1040px] w-full mx-auto px-5 pt-6 pb-10 flex flex-wrap justify-between gap-3 text-[13px] text-[var(--color-light-text-secondary)] dark:text-[var(--color-dark-text-secondary)]">
      <span>&copy; {year} Seva Netrebchenko</span>
      <span class="flex flex-wrap gap-x-[18px] gap-y-1">
        {footerLinks.map(({ href, label, external }) => (
          <a
            href={href}
            class="no-underline hover:text-[var(--color-light-text)] dark:hover:text-[var(--color-dark-text)] transition-colors"
            {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {label}
          </a>
        ))}
      </span>
    </footer>
  </body>
</html>
